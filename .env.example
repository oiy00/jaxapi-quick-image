# Upstream Sub2API origin. The browser talks to this app; the server proxies there.
JAXAPI_BASE_URL=https://jaxapi.top

# Production same-origin deploy at https://jaxapi.top/image
# NEXT_PUBLIC_BASE_PATH=/image
# NEXT_PUBLIC_API_MODE=same-origin

# SuperGPT video upstream. Server only. Never send this key to the browser.
# The key must be the group-11 upstream credential (accounts 31/32), never a group-7 key.
SUPERGPT_BASE_URL=https://api.supergpt.dev/v1
SUPERGPT_API_KEY=
SUPERGPT_USER_AGENT=curl/8.5.0

# off refuses paid video submits. http calls VIDEO_BILLING_URL.
# sql, database, sub2api, and admin are refused: stock video rates are unsafe,
# and this app does not edit customer balances or run refund SQL.
VIDEO_BILLING_ADAPTER=off
VIDEO_BILLING_URL=
VIDEO_BILLING_TOKEN=

# Absolute path on a persistent volume. Production currently has no volume.
VIDEO_JOB_STORE=/data/video-jobs.json
